{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "chrome",
      "runtimeExecutable": "/usr/bin/brave-browser",
      "port": 9222,
      "request": "launch",
      "name": "BrowserSync Brave",
      "url": "http://localhost:3000",
      "webRoot": "${workspaceFolder}/src",
      "preLaunchTask": "lanzarBrowserSync",
      "postDebugTask": "paraBrowserSync"
    },
    {
      "type": "chrome",
      "runtimeExecutable": "/usr/bin/brave-browser",
      "port": 9222,
      "request": "launch",
      "name": "BrowserSync Debug",
      "url": "http://localhost:3000",
      "webRoot": "${workspaceFolder}/",
      "preLaunchTask": "debugBrowserSync",
      "postDebugTask": "paraBrowserSync"
    },
  ]
}