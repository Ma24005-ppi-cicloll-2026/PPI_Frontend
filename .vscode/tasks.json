{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "lanzarBrowserSync",
            "command": "browser-sync start --server src -f \"src/**\" --no-open",
            "type": "shell",
            "presentation": {
                "reveal": "silent"
            },
            "isBackground": true,
            "problemMatcher": {
                "owner": "browsersync",
                "background": {
                    "activeOnStart": true,
                    "beginsPattern": "^\\[Browsersync\\] Access URLs:",
                    "endsPattern": "^\\[Browsersync\\] Watching files"
                },
                "pattern": { "regexp": "^(?!)$" }
            }
        },
        {
            "label": "debugBrowserSync",
            "command": "browser-sync start --server ./ -f \"src/**,test/**\" --no-open",
            "type": "shell",
            "presentation": {
                "reveal": "silent"
            },
            "isBackground": true,
            "problemMatcher": {
                "owner": "browsersync",
                "background": {
                    "activeOnStart": true,
                    "beginsPattern": "^\\[Browsersync\\] Access URLs:",
                    "endsPattern": "^\\[Browsersync\\] Watching files"
                },
                "pattern": { "regexp": "^(?!)$" }
            }
        },
        {
            "label": "paraBrowserSync",
            "command": "echo ${input:terminate}",
            "type": "shell",
            "problemMatcher": []
        }
    ],
    "inputs": [
        {
            "id": "terminate",
            "type": "command",
            "command": "workbench.action.tasks.terminate",
            "args": "terminateAll"
        }
    ]
}
